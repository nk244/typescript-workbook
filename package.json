{
  "name": "ts-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript 独学カリキュラム（演習 + 自動採点）",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src solutions",
    "verify:solutions": "node scripts/verify-solutions.mjs",
    "exam": "node scripts/exam.mjs",
    "exam:validate": "node scripts/exam.mjs --validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
